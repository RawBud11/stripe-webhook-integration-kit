# Copy to .env and adjust. All values here are fake; never put real secrets in this file.

# Fake endpoint signing secret used by the API and the simulator.
WEBHOOK_SECRET=whsec_test_fake_replace_me_with_any_random_string

# Allowed difference between the signature timestamp and now, in seconds. Must be > 0.
SIGNATURE_TOLERANCE_SECONDS=300

# Requests with a larger body are rejected before verification.
MAX_BODY_BYTES=262144

# Postgres from docker compose. Host port defaults to 5433 because 5432 is often in use.
POSTGRES_PASSWORD=integrationkit_fake_password
POSTGRES_PORT=5433

# Keep the password and port in these URLs in sync with the two values above.
DATABASE_URL=postgresql+psycopg://integrationkit:integrationkit_fake_password@127.0.0.1:5433/integrationkit
# Used only by the test suite; its database name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://integrationkit:integrationkit_fake_password@127.0.0.1:5433/integrationkit_test
